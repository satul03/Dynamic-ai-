# =============================================================================
# Competitor Dynamic Pricing & Alerting Configuration
# =============================================================================

# Optional: Slack Incoming Webhook for Real-Time Price Drop & Surge Alerts
# Format: https://hooks.slack-demo.internal/your-webhook-endpoint
SLACK_WEBHOOK_URL=

# Optional: Telegram Bot Notifications
# Get token from @BotFather, and chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database Path (default: bus_pricing_intelligence.db)
DB_PATH=bus_pricing_intelligence.db
